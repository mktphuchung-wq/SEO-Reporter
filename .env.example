# Public app origin for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client values. Use placeholders only; do not commit real secrets.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_GSC_SCOPE=https://www.googleapis.com/auth/webmasters.readonly

# Express session secret for local development.
SESSION_SECRET=replace-with-a-random-local-secret

# Optional local token storage path for development only.
GOOGLE_TOKEN_DB_PATH=.data/google-tokens.json

# Optional service account fallback for local GSC API testing.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional Gemini AI insight generation. Store the real key only in an environment variable.
GEMINI_API_KEY=your-gemini-api-key

# Internal access control. Comma- or newline-separated. Leave blank locally to allow any authenticated Google account.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Production/debug controls.
ENABLE_DEBUG_ROUTES=false
GEMINI_TIMEOUT_MS=12000
MAX_AI_ROWS=100
MAX_TRACKED_KEYWORDS=100
GSC_CACHE_TTL_SECONDS=300
